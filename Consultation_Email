%%[
VAR @sk,@rows,@row
VAR @fname,@lname,@email,@mobile,@job,@org

SET @sk = AttributeValue("SubscriberKey")

SET @rows = LookupRows(
    "RoboDoc_Lead_Capture_DE",
    "SubscriberKey",
    @sk
)

SET @updateURL = CloudPagesURL(
6465,
"SubscriberKey",
SubscriberKey
)

SET @url = CloudPagesURL(
6465,
"SubscriberKey",
SubscriberKey
)

IF RowCount(@rows) > 0 THEN

    SET @row = Row(@rows,1)

    SET @fname  = Field(@row,"FirstName")
    SET @lname  = Field(@row,"LastName")
    SET @email  = Field(@row,"EmailAddress")
    SET @mobile = Field(@row,"MobileNumber")
    SET @job    = Field(@row,"JobTitle")
    SET @org    = Field(@row,"OrganizationName")

ENDIF
]%%
