%%[
VAR @SubscriberKey,@rows,@row,@submitted,@updated

SET @SubscriberKey = RequestParameter("SubscriberKey")
SET @submitted = RequestParameter("submitted")

IF @submitted == "true" THEN

    SET @updated = UpsertData(
        "RoboDoc_Lead_Capture_DE",
        1,
        "SubscriberKey", @SubscriberKey,

        "FirstName", RequestParameter("FirstName"),
        "LastName", RequestParameter("LastName"),
        "MobileNumber", RequestParameter("MobileNumber"),
        "JobTitle", RequestParameter("JobTitle"),
        "OrganizationName", RequestParameter("OrganizationName"),
        "OrganizationType", RequestParameter("OrganizationType"),
        "ContactMethod", RequestParameter("ContactMethod"),
        "Comments", RequestParameter("Comments")
    )

]%%

<!DOCTYPE html>
<html>
<head>
<title>Update Successful</title>
<style>
body{
font-family:Arial;
background:#f4f7fa;
padding:50px;
text-align:center;
}
.card{
background:white;
max-width:700px;
margin:auto;
padding:40px;
border-radius:10px;
box-shadow:0 2px 10px rgba(0,0,0,.1);
}
h1{
color:#005b96;
}
</style>
</head>
<body>

<div class="card">
<h1>Request Updated Successfully</h1>
<p>Your RoboDoc consultation request has been updated.</p>
</div>

</body>
</html>

%%[

ELSE

SET @rows = LookupRows(
    "RoboDoc_Lead_Capture_DE",
    "SubscriberKey",
    @SubscriberKey
)

IF RowCount(@rows) > 0 THEN

SET @row = Row(@rows,1)

SET @FirstName = Field(@row,"FirstName")
SET @LastName = Field(@row,"LastName")
SET @EmailAddress = Field(@row,"EmailAddress")
SET @MobileNumber = Field(@row,"MobileNumber")
SET @JobTitle = Field(@row,"JobTitle")
SET @OrganizationName = Field(@row,"OrganizationName")
SET @OrganizationType = Field(@row,"OrganizationType")
SET @ContactMethod = Field(@row,"ContactMethod")
SET @Comments = Field(@row,"Comments")

ENDIF

]%%

<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>RoboDoc - Update Request</title>

<style>

body{
margin:0;
background:#f4f7fa;
font-family:Arial,Helvetica,sans-serif;
}

.hero{
background:#005b96;
color:white;
padding:40px;
text-align:center;
}

.container{
max-width:900px;
margin:40px auto;
padding:20px;
}

.card{
background:white;
padding:40px;
border-radius:10px;
box-shadow:0 2px 15px rgba(0,0,0,.08);
}

.form-group{
margin-bottom:20px;
}

label{
display:block;
margin-bottom:8px;
font-weight:bold;
}

input,
select,
textarea{
width:100%;
padding:12px;
border:1px solid #ccc;
border-radius:5px;
box-sizing:border-box;
}

textarea{
height:120px;
}

.row{
display:flex;
gap:20px;
}

.col{
flex:1;
}

.btn{
background:#005b96;
color:white;
border:none;
padding:14px 30px;
border-radius:5px;
cursor:pointer;
font-size:16px;
}

@media(max-width:768px){

.row{
flex-direction:column;
}

}

</style>
</head>

<body>

<div class="hero">
<h1>Update Consultation Request</h1>
<p>Modify your RoboDoc consultation details.</p>
</div>

<div class="container">

<div class="card">

<form method="post">

<input type="hidden"
name="submitted"
value="true">

<input type="hidden"
name="SubscriberKey"
value="%%=v(@SubscriberKey)=%%">

<div class="row">

<div class="col form-group">
<label>First Name</label>
<input type="text"
name="FirstName"
value="%%=v(@FirstName)=%%">
</div>

<div class="col form-group">
<label>Last Name</label>
<input type="text"
name="LastName"
value="%%=v(@LastName)=%%">
</div>

</div>

<div class="form-group">
<label>Email Address</label>
<input type="email"
value="%%=v(@EmailAddress)=%%"
disabled>
</div>

<div class="form-group">
<label>Mobile Number</label>
<input type="text"
name="MobileNumber"
value="%%=v(@MobileNumber)=%%">
</div>

<div class="form-group">
<label>Job Title</label>
<input type="text"
name="JobTitle"
value="%%=v(@JobTitle)=%%">
</div>

<div class="form-group">
<label>Organization Name</label>
<input type="text"
name="OrganizationName"
value="%%=v(@OrganizationName)=%%">
</div>

<div class="form-group">
<label>Organization Type</label>

<select name="OrganizationType">

<option value="Super Speciality Hospital">Super Speciality Hospital</option>
<option value="Multi-Speciality Hospital">Multi-Speciality Hospital</option>
<option value="Clinic">Clinic</option>
<option value="Medical College">Medical College</option>
<option value="Healthcare Group">Healthcare Group</option>

</select>

</div>

<div class="form-group">

<label>Preferred Contact Method</label>

<select name="ContactMethod">

<option value="Email">Email</option>
<option value="Phone">Phone</option>
<option value="Virtual Meeting">Virtual Meeting</option>

</select>

</div>

<div class="form-group">

<label>Comments</label>

<textarea
name="Comments">%%=v(@Comments)=%%</textarea>

</div>

<button type="submit" class="btn">
Update Request
</button>

</form>

</div>

</div>

</body>
</html>

%%[ ENDIF ]%%
